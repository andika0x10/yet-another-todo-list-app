/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "todo",
	"compatibility_date": "2026-11-19",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Secrets (never committed to the repo)
	 * Local: set them in .dev.vars (see .dev.vars.example)
	 * Production: npx wrangler secret put PIN, then npx wrangler secret put SESSION_SECRET
	 */
	"secrets": {
		"required": ["PIN", "SESSION_SECRET"]
	},
	/**
	 * D1: stores every card
	 * Run `npx wrangler d1 create todo-list`, then replace database_id below.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "todo-list",
			"database_id": "8d89b946-0d65-469f-ab16-aa6cd5f22ae8",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Durable Objects
	 * RATE_LIMITER: counts PIN attempts and limits card changes
	 * BOARD: broadcasts a "something changed" signal to every device over WebSocket
	 */
	"durable_objects": {
		"bindings": [
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
			{ "name": "BOARD", "class_name": "Board" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RateLimiter", "Board"]
		}
	]
}
